# Copy this file to `.env.local` and replace every placeholder with a real value.
# Never commit `.env.local` or paste its contents into issues, chat, or logs.

NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=kandarp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=kandarp_os
DATABASE_URL=postgresql://kandarp:replace-with-a-long-random-password@localhost:5432/kandarp_os?schema=public

# Generate separate random values for each secret; do not reuse passwords.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
MANAGED_SECRETS_KEY=replace-with-a-32-byte-base64-key
CONTACT_HASH_SECRET=replace-with-a-long-random-secret

ADMIN_OWNER_EMAIL=owner@example.com
ADMIN_OWNER_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kandarp-os
CONTACT_EMAIL_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
GITHUB_TOKEN=
